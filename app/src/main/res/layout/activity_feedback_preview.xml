<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F14"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/feedbackStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="피드백 대기"
        android:textColor="#F7FAFC"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/feedbackDistanceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="거리 정보 없음"
        android:textColor="#B8C2CC"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/feedbackSensorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="센서 대기"
        android:textColor="#7A8794"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/feedbackSafeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="안전 테스트" />

        <Button
            android:id="@+id/feedbackCautionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="주의 테스트" />

        <Button
            android:id="@+id/feedbackDangerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="위험 테스트" />

    </LinearLayout>

</LinearLayout>
